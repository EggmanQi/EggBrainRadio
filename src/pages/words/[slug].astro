---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const words = await getCollection('words');
  return words
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const formatted = entry.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article>
    <header class="page-intro">
      <h1>{entry.data.title}</h1>
      <p>{entry.data.summary}</p>
    </header>
    <div class="meta-row">
      <time datetime={entry.data.date.toISOString()}>{formatted}</time>
      {
        entry.data.tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))
      }
    </div>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
